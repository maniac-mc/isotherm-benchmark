# LAMMPS Input File (License CC BY 4.0)

variable number equal 50
variable seed equal 87669
variable mu equal -6.0
variable temp equal 300.0

include header.lmp

units real
dimension 3
atom_style full
boundary p p p

pair_style lj/cut ${cut_off}
pair_modify shift yes

read_data empty-pore.data
include parameters.inc

create_atoms 1 random ${number} 12345 NULL overlap 2.0 maxtry 5

group fluid type 1

fix mynve fluid nve
fix mylan fluid langevin ${temp} ${temp} 500.0 ${seed}

include widom.lmp

run 50000

write_data topology.data nocoeff
