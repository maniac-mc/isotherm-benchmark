# LAMMPS Input File (License CC BY 4.0)

variable number equal 1
variable seed equal 87669

# 1) Initialization
units real
dimension 3
atom_style full
bond_style harmonic
angle_style harmonic
boundary p p p

pair_style lj/cut/coul/long 17
pair_modify mix arithmetic

kspace_style ewald 1.0e-5
kspace_modify gewald 0.1622 kmax/ewald 6 6 6

region box block -20 20 -20 20 -20 20
create_box 2 box &
    bond/types 1 &
    angle/types 1 &
    extra/bond/per/atom 4 &
    extra/angle/per/atom 4 &
    extra/special/per/atom 4

include ../reference-files/parameters.inc

mass 1 15.9994
mass 2 12.011

molecule co2mol ../reference-files/co2.mol
create_atoms 0 random ${number} 3245 NULL mol co2mol 4585 overlap 2.0 maxtry 50

group CO2 type 1 2

include ../reference-files/output.lmp

run 50000

fix mywid all widom 100 500 1 ${seed} 300
fix myat7 all ave/time 100 5 500 f_mywid[1] f_mywid[2] f_mywid[3] file widom.dat

run 50000

write_data topology.data nocoeff
