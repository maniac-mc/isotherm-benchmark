# LAMMPS input file (License CC BY 4.0)

variable mu equal -0.1

units real
boundary p p p
atom_style full
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long 17
kspace_style ewald 1.0e-5
pair_modify shift yes mix arithmetic

region box block -20 20 -20 20 -20 20
create_box 2 box &
    bond/types 1 &
    angle/types 1 &
    extra/bond/per/atom 4 &
    extra/angle/per/atom 4 &
    extra/special/per/atom 4

include ../reference-files/parameters.inc

mass 1 15.9994
mass 2 12.011

molecule co2mol ../reference-files/co2.mol
create_atoms 0 random 100 3245 NULL mol co2mol 4585 overlap 2.0 maxtry 50

group CO2 type 1 2

variable tfac equal 5.0/3.0
fix mygcmc CO2 gcmc 10 1000 0 0 29494 300 ${mu} 0.01 mol co2mol tfac_insert ${tfac}

include ../reference-files/output.lmp

run 20000
write_data topology.data nocoeff
